+    private static String levelOrUnavailable(int level) {
+        return level < 1 ? "N/D" : String.valueOf(level);
+    }
+
+    private String compareSingleVsTorchLevels() {
+        if (singleFlashMaxLevel < 1 || captureTorchMaxLevel < 1) return "N/D";
+        return singleFlashMaxLevel > captureTorchMaxLevel ? "true" : "false";
+    }
